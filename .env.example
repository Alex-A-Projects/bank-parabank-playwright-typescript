# ---------------------------------------------------------------------------
# ParaBank test suite - environment variables
#
# Copy this file to `.env` and adjust. Every value the framework reads
# from the environment is listed here; nothing is hard-coded in the
# source. Real environment variables (CI, the shell, docker-compose)
# always win over the values in `.env`.
#
# Keys marked REQUIRED have no in-code fallback: the suite refuses to
# start without them rather than guessing.
# ---------------------------------------------------------------------------

# --- Environment axes -------------------------------------------------------
# Two independent axes:
#   TEST_ENV - where the browser navigates and which database the DB
#               suite talks to.
#   API_ENV  - which backend the API clients talk to. It never affects
#               browser navigation.
# The two may differ within a single run on purpose (for example
# TEST_ENV=local with API_ENV=cloud).
#
# Valid values: cloud | local
TEST_ENV=cloud
API_ENV=cloud

# --- Base URLs (REQUIRED) ---------------------------------------------------
# The public demo.
CLOUD_BASE_URL=https://parabank.parasoft.com/parabank
# The containerised instance started by docker-compose.yml. Keep the host
# port in step with PARABANK_HTTP_PORT below.
LOCAL_BASE_URL=http://localhost:8080/parabank

# --- API transport ----------------------------------------------------------
# Which transport the API suite speaks. The same test bodies run against
# all three.
#
# Valid values: soap | rest-json | rest-xml
API_TRANSPORT=soap

# --- Docker stack -----------------------------------------------------------
# Host ports for the compose stack. Change these when 8080/9001 are
# already taken on the machine.
PARABANK_HTTP_PORT=8080
PARABANK_DB_PORT=9001
PARABANK_JMS_PORT=61616

# --- Database (REQUIRED) ----------------------------------------------------
# JDBC coordinates of ParaBank's embedded HSQLDB, exposed in server mode
# on port 9001 inside the container.
DB_JDBC_URL=jdbc:hsqldb:hsql://localhost:9001/parabank
DB_USER=sa
DB_PASSWORD=

# --- Demo credentials (REQUIRED) --------------------------------------------
# ParaBank's seeded customer. Note that ParaBank does NOT create a
# customer on the fly - an unknown username is answered with "Invalid
# username and/or password" - so the seeded account is what the
# read-only scenarios use. New customers can only be created through the
# UI registration form.
DEMO_USERNAME=john
DEMO_PASSWORD=demo

# --- Playwright -------------------------------------------------------------
# Slow the suite down when debugging against a rate-limited demo.
# PWDEBUG=1
# PW_TEST_SLOWMO=250

# --- Reporting --------------------------------------------------------------
# Comma-separated list of Allure categories to keep, e.g.
# "Smoke,UI". Leave empty for everything.
# ALLURE_CATEGORIES=
