{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "moduleResolution": "node",
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "tests-ui/**/*.ts",
    "tests-api/**/*.ts",
    "tests-db/**/*.ts",
    "playwright.config.ts",
    "playwright.ui.config.ts",
    "playwright.api.config.ts",
    "playwright.db.config.ts"
  ],
  "exclude": ["node_modules", "dist", "test-results", "playwright-report", "allure-results", "allure-report"]
}
