{
  "name": "bank-parabank-playwright-typescript",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test framework for ParaBank: UI, API and database suites",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "playwright test",
    "test:all": "npm run test:ui && npm run test:api && npm run test:db",
    "test:ui": "playwright test --config=playwright.ui.config.ts",
    "test:api": "playwright test --config=playwright.api.config.ts",
    "test:db": "TEST_ENV=local playwright test --config=playwright.db.config.ts",
    "test:headed": "playwright test --config=playwright.ui.config.ts --headed",
    "test:ui-mode": "playwright test --config=playwright.ui.config.ts --ui",
    "test:debug": "playwright test --config=playwright.ui.config.ts --debug",
    "test:report": "playwright show-report",
    "allure:serve": "allure serve allure-results",
    "allure:generate": "allure generate allure-results -o allure-report",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:restart": "docker compose down && docker compose up -d",
    "codegen": "playwright codegen"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "allure-playwright": "^3.14.0",
    "fast-xml-parser": "^5.12.0"
  }
}
