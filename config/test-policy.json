{
  "$comment": [
    "Feature gating matrix: env -> feature -> enabled.",
    "Read through TEST_ENV. A test tagged for a disabled feature is skipped;",
    "a test tagged with an unknown feature fails loudly.",
    "",
    "Environments:",
    "  cloud = the public demo at parabank.parasoft.com",
    "  local = the Dockerised ParaBank container",
    "",
    "Why the db-* and api-db-lifecycle features are cloud-disabled:",
    "  - The public demo does NOT expose its HSQLDB on port 9001, so the",
    "    database suite physically cannot connect there.",
    "  - The DB-lifecycle endpoints (cleanDB / initializeDB) are destructive",
    "    against a shared instance that other users depend on."
  ],
  "envs": {
    "cloud": {
      "features": {
        "ui-home": true,
        "ui-about": true,
        "ui-contact": true,
        "ui-login": true,
        "ui-logout": true,
        "ui-forgot-login": true,
        "ui-register": true,
        "ui-account-overview": true,
        "ui-account-details": true,
        "ui-open-account": true,
        "ui-transfer-funds": true,
        "ui-bill-pay": true,
        "ui-find-transactions": true,
        "ui-update-contact-info": true,
        "ui-request-loan": true,
        "ui-admin": true,
        "ui-navigation": true,
        "api-auth": true,
        "api-customer": true,
        "api-account": true,
        "api-transaction": true,
        "api-money-movement": true,
        "api-stocks": true,
        "api-jms": true,
        "api-db-lifecycle": false,
        "db-customer": false,
        "db-account": false,
        "db-transaction": false,
        "db-integration": false
      }
    },
    "local": {
      "features": {
        "ui-home": true,
        "ui-about": true,
        "ui-contact": true,
        "ui-login": true,
        "ui-logout": true,
        "ui-forgot-login": true,
        "ui-register": true,
        "ui-account-overview": true,
        "ui-account-details": true,
        "ui-open-account": true,
        "ui-transfer-funds": true,
        "ui-bill-pay": true,
        "ui-find-transactions": true,
        "ui-update-contact-info": true,
        "ui-request-loan": true,
        "ui-admin": true,
        "ui-navigation": true,
        "api-auth": true,
        "api-customer": true,
        "api-account": true,
        "api-transaction": true,
        "api-money-movement": true,
        "api-stocks": true,
        "api-jms": true,
        "api-db-lifecycle": true,
        "db-customer": true,
        "db-account": true,
        "db-transaction": true,
        "db-integration": true
      }
    }
  }
}
